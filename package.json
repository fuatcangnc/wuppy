{
	"name": "wuppy-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=22.16"
	},
	"scripts": {
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"lint": "oxlint --deny-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"test:e2e": "pnpm --filter @wuppy/admin build && pnpm --filter wuppy-starter build && pnpm --filter @wuppy/e2e e2e",
		"build": "pnpm --filter './packages/*' build && pnpm --filter wuppy smoke:dist"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"vitest": "catalog:",
		"oxlint": "catalog:",
		"prettier": "catalog:"
	}
}
