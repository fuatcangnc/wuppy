{
	"name": "wuppy-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=22.16"
	},
	"scripts": {
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"lint": "oxlint --deny-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"test:e2e": "pnpm --filter @wuppycms/admin build && pnpm --filter wuppy-starter build && pnpm --filter @wuppycms/e2e e2e",
		"build": "pnpm --filter './packages/*' build && pnpm --filter wuppycms smoke:dist",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish",
		"verify:pack": "node scripts/verify-pack.mjs",
		"knip": "knip --no-progress",
		"seed:sites": "node scripts/seed-sites.mjs"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"knip": "^6.42.1",
		"oxlint": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
