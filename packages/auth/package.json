{
	"name": "@wuppycms/auth",
	"version": "0.2.3",
	"description": "Authentication for WuppyCMS (Better Auth with passkeys and two-factor sign-in).",
	"keywords": [
		"wuppycms",
		"auth",
		"better-auth",
		"passkey"
	],
	"homepage": "https://wuppycms.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fuatcangnc/wuppy.git",
		"directory": "packages/auth"
	},
	"bugs": "https://github.com/fuatcangnc/wuppy/issues",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsdown"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.12",
		"better-auth": "1.7.12",
		"reflect-metadata": "0.2.2"
	},
	"devDependencies": {
		"@better-auth/utils": "0.5.0",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"files": [
		"dist",
		"types"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./types/index.d.ts",
				"import": "./dist/index.mjs"
			}
		}
	}
}
