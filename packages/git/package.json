{
	"name": "@wuppycms/git",
	"version": "0.2.4",
	"description": "Git storage for WuppyCMS: commits, history and diffs for content files.",
	"keywords": [
		"wuppycms",
		"git",
		"cms"
	],
	"homepage": "https://wuppycms.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fuatcangnc/wuppy.git",
		"directory": "packages/git"
	},
	"bugs": "https://github.com/fuatcangnc/wuppy/issues",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsdown"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"tsdown": "catalog:"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"import": "./dist/index.mjs"
			}
		}
	}
}
