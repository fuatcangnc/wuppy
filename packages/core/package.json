{
	"name": "wuppy",
	"version": "0.0.0",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./astro": "./src/astro/integration.ts",
		"./seo": "./src/seo/index.ts",
		"./publishing": "./src/publishing/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsdown",
		"smoke:dist": "node scripts/smoke-dist.mjs"
	},
	"dependencies": {
		"@wuppy/admin": "workspace:*",
		"@wuppy/auth": "workspace:*",
		"@wuppy/git": "workspace:*",
		"@wuppy/plugin-types": "workspace:*",
		"hono": "catalog:",
		"quickjs-emscripten": "0.32.0",
		"resend": "^6.34.1",
		"yaml": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"astro": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"astro": "catalog:"
	},
	"bin": {
		"wuppy": "./src/cli/main.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"import": "./dist/index.mjs"
			},
			"./astro": {
				"types": "./dist/astro.d.mts",
				"import": "./dist/astro.mjs"
			},
			"./seo": {
				"types": "./dist/seo.d.mts",
				"import": "./dist/seo.mjs"
			},
			"./publishing": {
				"types": "./dist/publishing.d.mts",
				"import": "./dist/publishing.mjs"
			}
		},
		"bin": {
			"wuppy": "./dist/cli.mjs"
		}
	}
}
