{
	"name": "wuppycms",
	"version": "0.2.3",
	"description": "WuppyCMS: a file-based, Git-backed CMS and admin panel for Astro.",
	"keywords": [
		"astro",
		"astro-integration",
		"cms",
		"headless-cms",
		"markdown",
		"mdx",
		"git",
		"withastro"
	],
	"homepage": "https://wuppycms.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fuatcangnc/wuppy.git",
		"directory": "packages/core"
	},
	"bugs": "https://github.com/fuatcangnc/wuppy/issues",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./astro": "./src/astro/integration.ts",
		"./seo": "./src/seo/index.ts",
		"./publishing": "./src/publishing/index.ts",
		"./site": "./src/site/index.ts",
		"./markdown": "./src/markdown/render.ts",
		"./mdx": "./src/markdown/render.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsdown",
		"smoke:dist": "node scripts/smoke-dist.mjs"
	},
	"dependencies": {
		"@astrojs/compiler-rs": "^0.5.2",
		"@wuppycms/admin": "workspace:*",
		"@wuppycms/auth": "workspace:*",
		"@wuppycms/git": "workspace:*",
		"@wuppycms/plugin-types": "workspace:*",
		"@wuppycms/visual-editor": "workspace:*",
		"hono": "catalog:",
		"nodemailer": "^10.1.7",
		"quickjs-emscripten": "0.32.0",
		"resend": "^6.34.1",
		"typescript": "catalog:",
		"yaml": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/nodemailer": "^8.0.2",
		"astro": "catalog:",
		"tsdown": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"astro": "catalog:"
	},
	"bin": {
		"wuppycms": "./src/cli/main.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"import": "./dist/index.mjs"
			},
			"./astro": {
				"types": "./dist/astro.d.mts",
				"import": "./dist/astro.mjs"
			},
			"./seo": {
				"types": "./dist/seo.d.mts",
				"import": "./dist/seo.mjs"
			},
			"./publishing": {
				"types": "./dist/publishing.d.mts",
				"import": "./dist/publishing.mjs"
			},
			"./site": {
				"types": "./dist/site.d.mts",
				"import": "./dist/site.mjs"
			},
			"./markdown": {
				"types": "./dist/markdown.d.mts",
				"import": "./dist/markdown.mjs"
			},
			"./mdx": {
				"types": "./dist/mdx.d.mts",
				"import": "./dist/mdx.mjs"
			}
		},
		"bin": {
			"wuppycms": "./dist/cli.mjs"
		}
	},
	"optionalDependencies": {
		"sharp": "0.35.5"
	}
}
