{
	"name": "@wuppycms/plugin-cli",
	"version": "0.3.0",
	"description": "Build and package WuppyCMS plugins.",
	"keywords": [
		"wuppycms",
		"plugin",
		"cli"
	],
	"homepage": "https://wuppycms.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fuatcangnc/wuppy.git",
		"directory": "packages/plugin-cli"
	},
	"bugs": "https://github.com/fuatcangnc/wuppy/issues",
	"type": "module",
	"bin": {
		"wuppycms-plugin": "./src/main.ts"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsdown"
	},
	"dependencies": {
		"@wuppycms/plugin-types": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"bin": {
			"wuppycms-plugin": "./dist/main.mjs"
		},
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"import": "./dist/index.mjs"
			}
		}
	}
}
