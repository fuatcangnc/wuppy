WUPPY_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Resend transactional email (optional; Settings -> Email provider must be "resend")
RESEND_API_KEY=
# Published Resend template used for magic-link sign-in emails
RESEND_MAGIC_LINK_TEMPLATE=7979a32e-432b-4866-b92f-9c99fd7d46bb
# Session policy (optional; defaults shown). Changing these requires a restart.
WUPPY_SESSION_DAYS=7
WUPPY_SESSION_UPDATE_HOURS=24
# Reverse-proxy IPs/CIDRs allowed to supply X-Forwarded-For (comma-separated).
# Leave empty when clients reach the app directly.
# WUPPY_TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8
# WebAuthn passkeys require localhost or a real domain; 127.0.0.1 is not a valid RP ID.
# Optional overrides for a proxy or a custom admin origin:
# WUPPY_PASSKEY_RP_ID=localhost
# WUPPY_PASSKEY_ORIGIN=http://localhost:4330
# OAuth sign-in (optional; for existing accounts that connect a provider)
# Register these callback URLs: <WUPPY_URL>/api/auth/callback/<provider>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Google Workspace domain restriction
GOOGLE_HOSTED_DOMAIN=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional Microsoft Entra ID tenant (defaults to common)
MICROSOFT_TENANT_ID=common

# Visual editor AI and assistant (any OpenAI-compatible endpoint)
WUPPY_AI_BASE_URL=
WUPPY_AI_API_KEY=
WUPPY_AI_MODELS=
