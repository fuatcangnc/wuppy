---
import { Button } from "@/ui/button";
interface Props {
	collection: string;
	slug: string;
}
const { collection, slug } = Astro.props;
const endpoint = `/api/public/comments/${collection}/${slug}`;
---
<section class="section" style="border-top:1px solid var(--line)" data-comments data-endpoint={endpoint}>
	<div class="narrow">
	<p class="kicker">Join the conversation</p>
	<h2 class="heading">Comments</h2>
	<ul data-comment-list class="comment-list"></ul>
	<form data-comment-form class="panel" style="display:grid;gap:1rem;margin-top:2rem">
		<label class="field">
			<span>Name</span>
			<input name="author" required maxlength="100" class="input" />
		</label>
		<label class="field">
			<span>Email (not published)</span>
			<input name="email" type="email" maxlength="200" class="input" />
		</label>
		<label class="field">
			<span>Comment</span>
			<textarea name="body" required maxlength="5000" rows="4" class="input"></textarea>
		</label>
		<input name="website" tabindex="-1" autocomplete="off" hidden aria-hidden="true" />
		<Button type="submit" class="h-12 px-5 text-xs font-bold uppercase tracking-wider justify-self-start hover:bg-ink">Post comment</Button>
		<p data-comment-status role="status" class="meta"></p>
	</form>
	</div>
</section>

<script>
	const section = document.querySelector("[data-comments]");
	if (section) {
		const endpoint = section.getAttribute("data-endpoint") || "";
		const list = section.querySelector("[data-comment-list]");
		const form = section.querySelector("[data-comment-form]");
		const status = section.querySelector("[data-comment-status]");

		const render = (comments) => {
			if (!list) return;
			list.innerHTML = "";
			for (const comment of comments) {
				const li = document.createElement("li");
				const author = document.createElement("p");
				author.style.fontWeight = "700";
				author.textContent = comment.author;
				const body = document.createElement("p");
				body.textContent = comment.body;
				li.append(author, body);
				list.append(li);
			}
		};

		const load = async () => {
			const res = await fetch(endpoint);
			if (res.ok) render((await res.json()).data ?? []);
		};

		form?.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!(form instanceof HTMLFormElement)) return;
			const data = Object.fromEntries(new FormData(form));
			const res = await fetch(endpoint, {
				method: "POST",
				headers: { "Content-Type": "application/json", "X-Wuppy-Request": "1" },
				body: JSON.stringify(data),
			});
			if (res.ok) {
				form.reset();
				if (status) status.textContent = "Thanks. Your comment is awaiting moderation.";
				await load();
			} else if (status) {
				status.textContent = "Could not post the comment.";
			}
		});

		void load();
	}
</script>
