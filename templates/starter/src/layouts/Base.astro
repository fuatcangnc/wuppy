---
import { buildSeo, renderHead, renderJsonLd, websiteJsonLd } from "wuppycms/seo";
import { readData } from "wuppycms";
import Brand from "../components/Brand.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WidgetArea from "../components/WidgetArea.astro";
import "../styles/theme.css";
import config from "../../wuppy.config.mjs";

interface MenuItem {
	label: string;
	href: string;
	children?: MenuItem[];
}
const menus = await readData<Array<{ name: string; label: string; location: string; items: MenuItem[] }>>("menus", []);
const main = menus.find((menu) => menu.location === "header") ?? null;
const footerMenu = menus.find((menu) => menu.location === "footer") ?? null;
const settings = await readData<{
	siteName?: string;
	siteUrl?: string;
	description?: string;
	logo?: string;
	locale?: string;
	seo?: { title?: string; description?: string; image?: string; noindex?: boolean; titleTemplate?: string };
} | null>("settings", null);
const site = {
	name: settings?.siteName || config.site.name,
	url: settings?.siteUrl || config.site.url,
};

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	canonical?: string;
	/** schema.org data for this page (see `articleJsonLd`); the home page gets WebSite data by default. */
	jsonLd?: object;
	editHref?: string;
}
const seo = buildSeo({
	site,
	path: Astro.url.pathname,
	title: Astro.props.title ?? settings?.seo?.title,
	description: Astro.props.description ?? settings?.seo?.description,
	image: Astro.props.image ?? settings?.seo?.image,
	noindex: Astro.props.noindex ?? settings?.seo?.noindex,
	canonical: Astro.props.canonical,
	titleTemplate: settings?.seo?.titleTemplate,
});
const jsonLd = Astro.props.jsonLd ?? (Astro.url.pathname === "/" ? websiteJsonLd(site, "/search?q={q}") : undefined);
const icon = {
	search: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>',
	rss: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>',
};
---
<html lang={settings?.locale || "en"}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Fragment set:html={renderHead(seo)} />
		{jsonLd && <Fragment set:html={renderJsonLd(jsonLd)} />}
		<link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
		<link rel="preload" href="/fonts/space-grotesk-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<a href="#content" class="skip-link">Skip to content</a>
		<SiteHeader name={site.name} tagline={settings?.description} logo={settings?.logo} menu={main} />
		<main id="content">
			<slot />
		</main>
		{Astro.props.editHref && (import.meta.env.DEV || Astro.url.searchParams.has("wuppy-edit")) && (
			<a href={Astro.props.editHref} class="edit-link">Edit this page</a>
		)}
		<footer class="site-footer">
			<div class="shell footer-grid">
				<div>
					<Brand name={site.name} logo={settings?.logo} inverse />
					{settings?.description && <p>{settings.description}</p>}
				</div>
				{(footerMenu ?? main) && (
					<nav aria-label={(footerMenu ?? main)!.label}>
						<h2>{(footerMenu ?? main)!.label}</h2>
						<ul>{(footerMenu ?? main)!.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
					</nav>
				)}
				<WidgetArea name="footer" />
			</div>
			<div class="footer-bottom">
				<div class="shell">
					<span>© {new Date().getFullYear()} {site.name}</span>
					<div class="social">
						<a href="/rss.xml" aria-label="RSS feed"><Fragment set:html={icon.rss} /></a>
						<a href="/search" aria-label="Search the site"><Fragment set:html={icon.search} /></a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
