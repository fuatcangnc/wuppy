---
import { getCollection } from "astro:content";
import { readData } from "wuppy";
import PageHero from "../../components/PageHero.astro";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";

const slug = Astro.params.slug ?? "";
const taxonomies = await readData<Array<{ name: string; terms: Array<{ slug: string; name: string }> }>>("taxonomies", []);
const taxonomy = taxonomies.find((item) => item.name === "categories");
const term = taxonomy?.terms.find((item) => item.slug === slug);
if (!taxonomy || !term) return Astro.rewrite("/404");
const posts = await getCollection(
	"posts",
	({ data }) => data.draft !== true && (data.categories ?? []).includes(slug),
);
---
<Base title={`Category: ${term.name}`}>
	<PageHero title={term.name} kicker="Category" crumbs={[{ label: "Categories" }, { label: term.name }]} />
	<section class="section section--soft">
		<div class="shell">
			<ul class="cards">
				{posts.map((post) => (
					<li><PostCard href={`/posts/${post.id}`} title={post.data.title} date={post.data.date} cover={post.data.cover} /></li>
				))}
			</ul>
		</div>
	</section>
</Base>
