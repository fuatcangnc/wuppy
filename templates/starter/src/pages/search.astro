---
import { getCollection } from "astro:content";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";

const posts = await getCollection("posts", ({ data }) => data.draft !== true);
const items = posts.map((post) => ({
	title: post.data.title,
	slug: post.id,
	body: post.body,
}));
---
<Base title="Search">
	<PageHero title="Search" kicker="Find a post" crumbs={[{ label: "Search" }]} />
	<section class="section">
		<div class="narrow">
			<input id="q" type="search" placeholder="Search posts…" class="input" aria-label="Search posts" autofocus />
			<ul id="results" class="cards" style="margin-top:1.5rem;grid-template-columns:1fr"></ul>
		</div>
	</section>
	<script define:vars={{ items }}>
		const input = document.getElementById("q");
		const results = document.getElementById("results");
		const render = (list) => {
			results.innerHTML = "";
			for (const item of list) {
				const li = document.createElement("li");
				li.className = "card";
				const body = document.createElement("div");
				body.className = "card-body";
				const a = document.createElement("a");
				a.href = `/posts/${item.slug}`;
				a.textContent = item.title;
				body.append(a);
				li.append(body);
				results.append(li);
			}
		};
		const params = new URLSearchParams(location.search);
		const search = () => {
			const q = input.value.trim().toLowerCase();
			render(q ? items.filter((item) => `${item.title}\n${item.body}`.toLowerCase().includes(q)) : []);
		};
		input.value = params.get("q") ?? "";
		input.addEventListener("input", search);
		search();
	</script>
</Base>
