---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const slug = Astro.params.slug ?? "";
const posts = await getCollection("posts", ({ data }) => data.draft !== true && (data.tags ?? []).includes(slug));
if (posts.length === 0) return new Response("Not found", { status: 404 });
---
<Base title={`Tag: ${slug}`}>
	<h1>Tag: {slug}</h1>
	<ul>
		{posts.map((post) => (
			<li><a href={`/posts/${post.id}`}>{post.data.title}</a></li>
		))}
	</ul>
</Base>
