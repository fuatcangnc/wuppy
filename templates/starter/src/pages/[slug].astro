---
import { getEntry, render } from "astro:content";
import { verifyPreview } from "wuppycms/publishing";
import InlineTitle from "../components/InlineTitle.astro";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";

const editable = Astro.url.searchParams.has("wuppy-edit");

const slug = Astro.params.slug ?? "";
const page = await getEntry("pages", slug);
if (!page) return Astro.rewrite("/404");
const previewing = verifyPreview(
	import.meta.env.WUPPY_SECRET ?? process.env.WUPPY_SECRET ?? "",
	"pages",
	slug,
	Astro.url.searchParams.get("wuppy-preview"),
);
if (page.data.draft === true && !import.meta.env.DEV && !previewing) return Astro.rewrite("/404");
if (previewing) Astro.response.headers.set("Cache-Control", "no-store");
const { Content } = await render(page);
---
<Base
	title={page.data.seoTitle ?? page.data.title}
	description={page.data.seoDescription}
	noindex={page.data.noindex === true || previewing}
	editHref={`/admin/e/pages/${slug}`}
>
	<PageHero title={page.data.title} crumbs={[{ label: page.data.title }]}>
		<InlineTitle slot="title" collection="pages" slug={slug} title={page.data.title} editable={editable} />
	</PageHero>
	<article class="section">
		<div class="narrow prose"><Content /></div>
	</article>
</Base>
