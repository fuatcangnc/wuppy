---
import { getCollection } from "astro:content";
import { getByline, readData } from "wuppy";
import Base from "../../layouts/Base.astro";

const slug = Astro.params.slug ?? "";
const byline = await getByline(slug);
const fields = await readData<Array<{ name: string; label: string; type: string }>>("byline-schema", []);
if (!byline) return Astro.rewrite("/404");
const posts = await getCollection("posts", ({ data }) => data.draft !== true && data.author === slug);
---
<Base title={byline.name}>
	<h1>{byline.name}</h1>
	{byline.avatar && <img src={byline.avatar} alt="" class="mt-2 size-20 rounded-full object-cover" />}
	{byline.bio && <p class="mt-2">{byline.bio}</p>}
	<dl class="mt-2">
		{fields.filter((f) => byline.extra[f.name]).map((f) => (
			<><dt>{f.label}</dt><dd>{f.type === "url" ? <a href={byline.extra[f.name]}>{byline.extra[f.name]}</a> : byline.extra[f.name]}</dd></>
		))}
	</dl>
	<ul class="mt-4">
		{posts.map((post) => (
			<li><a href={`/posts/${post.id}`}>{post.data.title}</a></li>
		))}
	</ul>
</Base>
