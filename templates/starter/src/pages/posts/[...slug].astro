---
import { isPublished } from "wuppycms/publishing";
import { getCollection, render } from "astro:content";
import PageHero from "../../components/PageHero.astro";
import Base from "../../layouts/Base.astro";

export const prerender = false;

const posts = await getCollection("posts", ({ data }) => import.meta.env.DEV || isPublished(data));
const post = posts.find((p) => p.id === Astro.params.slug);
if (!post) return Astro.rewrite("/404");
const { Content } = await render(post);
---
<Base title={post.data.title} noindex={post.data.draft}>
	<PageHero title={post.data.title} crumbs={[{ label: "Posts", href: "/#posts" }, { label: post.data.title }]} />
	<article class="section">
		<div class="narrow prose"><Content /></div>
	</article>
</Base>
