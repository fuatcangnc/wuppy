---
import { getCollection, getEntry, render } from "astro:content";
import { isPublished, verifyPreview } from "wuppy/publishing";
import { articleJsonLd } from "wuppy/seo";
import { readingTime, related } from "wuppy/site";
import { readData } from "wuppy";
import Comments from "../../components/Comments.astro";
import InlineTitle from "../../components/InlineTitle.astro";
import PageHero from "../../components/PageHero.astro";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";

const editable = Astro.url.searchParams.has("wuppy-edit");

const slug = Astro.params.slug ?? "";
const post = await getEntry("posts", slug);
if (!post) return Astro.rewrite("/404");
// A signed preview link (made in the admin) shows one unpublished entry to someone without an account.
const previewing = verifyPreview(
	import.meta.env.WUPPY_SECRET ?? process.env.WUPPY_SECRET ?? "",
	"posts",
	slug,
	Astro.url.searchParams.get("wuppy-preview"),
);
if (post.data.draft === true && !import.meta.env.DEV && !previewing) return Astro.rewrite("/404");
if (previewing) Astro.response.headers.set("Cache-Control", "no-store");
const { Content } = await render(post);
const minutes = readingTime(post.body ?? "");
const others = (await getCollection("posts", ({ data }) => isPublished(data)));
const more = related(post, others, "tags");
const bylines = await readData<Array<{ slug: string; name: string; bio: string }>>("bylines", []);
const settings = await readData<{ siteName?: string } | null>("settings", null);
const author = bylines.find((item) => item.slug === post.data.author);
const taxonomies = await readData<Array<{ name: string; terms: Array<{ slug: string; name: string }> }>>(
	"taxonomies",
	[],
);
const categories = taxonomies.find((item) => item.name === "categories")?.terms ?? [];
const selectedCategories = categories.filter((term) => (post.data.categories ?? []).includes(term.slug));
const media = await readData<{ meta: Record<string, { alt?: string; focalX?: number; focalY?: number }> }>("media", { meta: {} });
const coverMeta = post.data.cover ? media.meta[post.data.cover] : undefined;
---
<Base
	title={String(post.data.seoTitle ?? post.data.title)}
	description={typeof post.data.seoDescription === "string" ? post.data.seoDescription : undefined}
	noindex={post.data.noindex === true || previewing}
	canonical={post.data.canonical}
	jsonLd={articleJsonLd({
		site: { name: settings?.siteName || "Site", url: Astro.url.origin },
		url: Astro.url.pathname,
		title: post.data.title,
		description: typeof post.data.seoDescription === "string" ? post.data.seoDescription : undefined,
		image: post.data.cover,
		datePublished: post.data.date?.toISOString(),
		author: author?.name,
	})}
	editHref={`/admin/e/posts/${slug}`}
>
	<PageHero title={post.data.title} kicker="Article" crumbs={[{ label: "Posts", href: "/#posts" }, { label: post.data.title }]}>
		<InlineTitle slot="title" collection="posts" slug={slug} title={post.data.title} editable={editable} />
		<p class="meta" style="margin-top:1rem">
			{author && <>By <a href={`/authors/${author.slug}`}>{author.name}</a> · </>}
			{post.data.date && <><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("en", { dateStyle: "long" })}</time> · </>}
			{minutes} min read
		</p>
		{selectedCategories.length > 0 && (
			<ul class="chips">
				{selectedCategories.map((category) => <li><a href={`/categories/${category.slug}`}>{category.name}</a></li>)}
			</ul>
		)}
	</PageHero>
	<article class="section">
		<div class="narrow prose">
			{post.data.cover && (
				<img
					src={post.data.cover}
					alt={coverMeta?.alt ?? ""}
					class="cover"
					style={`object-position: ${coverMeta?.focalX ?? 50}% ${coverMeta?.focalY ?? 50}%`}
				/>
			)}
			<Content />
			{(post.data.tags ?? []).length > 0 && (
				<ul class="chips" aria-label="Tags">
					{(post.data.tags ?? []).map((tag: string) => <li><a href={`/tags/${tag}`}>#{tag}</a></li>)}
				</ul>
			)}
		</div>
	</article>
	{more.length > 0 && (
		<aside aria-label="Related posts" class="section section--soft">
			<div class="shell">
				<p class="kicker">Keep reading</p>
				<h2 class="heading" style="margin-bottom:2rem">Related</h2>
				<ul class="cards">{more.map((p) => <li><PostCard href={`/posts/${p.id}`} title={p.data.title} date={p.data.date} cover={p.data.cover} headingLevel={3} /></li>)}</ul>
			</div>
		</aside>
	)}
	<Comments collection="posts" slug={slug} />
</Base>
