{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": ["**/.wuppy/**"],
	"ignoreDependencies": ["vitest"],
	"workspaces": {
		"packages/admin": {
			"ignoreDependencies": ["@lexical/history"]
		},
		"packages/auth": {
			"entry": ["types/index.d.ts", "tests/public-types.ts"]
		},
		"packages/core": {
			"ignoreDependencies": ["@wuppycms/admin"]
		},
		"landing": {
			"entry": ["wuppy.config.mjs"]
		},
		"templates/starter": {
			"ignore": ["content/**"],
			"ignoreDependencies": ["zod"]
		}
	},
	"rules": {
		"exports": "off",
		"types": "off",
		"nsExports": "off",
		"nsTypes": "off",
		"duplicates": "off"
	}
}
